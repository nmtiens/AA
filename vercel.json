{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "backend/api/dist.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["backend/node_modules/bcrypt/**"]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/api/dist.js" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}