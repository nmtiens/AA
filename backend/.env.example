# Sao chép thành backend/.env (file .env đã nằm trong .gitignore, KHÔNG commit).
# Xem docs/huong-dan-dung-moi-truong.md để biết thứ tự dựng môi trường.

# Cổng backend khi chạy dev (Vite proxy /api -> cổng này)
PORT=5000

# Chuỗi kết nối PostgreSQL. Dev: có thể dùng DB thử nghiệm (ít dữ liệu hơn DB thật).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Khoá ký JWT. BẮT BUỘC ở production (NODE_ENV=production thì thiếu là server không chạy).
# Dev để trống sẽ dùng 'dev-only-insecure-secret'.
JWT_SECRET=

# Domain được phép gọi API (CORS), nhiều domain cách nhau dấu phẩy. BẮT BUỘC ở production.
ALLOWED_ORIGINS=http://localhost:3000

# Khoá cho GET /api/warmup (header x-warmup-key) — làm nóng cache sau khi deploy.
WARMUP_SECRET=

# Khoá cho /api/cron/* (Vercel Cron gửi "Authorization: Bearer <CRON_SECRET>", dịch vụ khác dùng header x-cron-key).
CRON_SECRET=

# Thông báo đẩy (Web Push) cho app vướng mắc. Tạo cặp khoá: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# In thời gian từng câu SQL ra log ([db timing] ...). Bỏ trống để tắt.
# DEBUG_DB_TIMING=1
